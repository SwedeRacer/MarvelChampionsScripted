function fearNoEvilUnderlingButtonClicked(player, value, id)
    local underlingButtonIds = {"bullseye", "electro", "hammerhead", "purpleMan", "typhoidMary", "random"}

    for _, underlingButtonId in ipairs(underlingButtonIds) do
        local isSelected = underlingButtonId == id
        Global.UI.setAttribute("underlingHighlight-" .. underlingButtonId, "color",
            isSelected and "rgba(1,1,0,1)" or "rgba(0,0,0,0)")
    end

    selectedScenario.underlingButtonId = id
    selectedScenario.underlingKey = id
end

function fearNoEvilResetTyphoidMary()
    local villainHpCounter = getObjectFromGUID(currentScenario.villains.typhoidMary.hpCounter.guid)
    local mode = currentScenario.mode
    local stage = mode == "standard" and currentScenario.villains.typhoidMary.stages.stageA or
                      currentScenario.villains.typhoidMary.stages.stageB
    local heroCount = getHeroCount()

    villainHpCounter.call("setValue", {
        value = stage.hitPointsPerPlayer * heroCount
    })

    local disturbedPsycheCardId = "60112"
    local disturbedPsycheCard = Global.call("findCard", {
        cardId = disturbedPsycheCardId
    })
    local disturbedPsycheCounter = Global.call("getCounterFromCard", {
        card = disturbedPsycheCard,
        counterClass = "configured"
    })

    disturbedPsycheCounter.call("adjustValue", {
        adjustment = 1
    })

    local currentDisturbedPsycheDamage = disturbedPsycheCounter.call("getValue")

    if currentDisturbedPsycheDamage >= 3 then
        Global.call("displayMessage", {
            message = "Typhoid Mary has been defeated. The Heroes win!",
            messageType = Global.getVar("MESSAGE_TYPE_ALERT")
        })
    end

    local villainCard = Global.call("findCard", {
        cardId = stage.cardId
    })

    local villainIsFaceUp = Global.call("isFaceUp", {
        object = villainCard,
        ignoreToggles = true
    })

    villainCard.flip()

    villainIsFaceUp = not villainIsFaceUp
    fearNoEvilApplyTyphoidMaryExpertEffects(mode, villainIsFaceUp)
end

function fearNoEvilApplyTyphoidMaryExpertEffects(mode, villainIsFaceUp)
    if (mode == "expert") then
        if (villainIsFaceUp) then
            Global.call("addStatusToVillain", {
                villain = currentScenario.villains.typhoidMary,
                statusType = "tough"
            })
        else
            Global.call("displayMessage", {
                message = "Bloody Mary deals 1 damage to each identity.",
                messageType = Global.getVar("MESSAGE_TYPE_INSTRUCTION")
            })
        end
    end
end

function setUpSchemeStage_kingpin_main(params)
    local stage = params.stage
    local stageNumber = string.sub(stage.key, -1)
    local mode = getMode()
    local publicSupportCardId = "60163"
    local organizedCrimeCardId = "60174"

    if (stageNumber == "1") then
        kingpinPlaceAllNemesisDecks()
        Global.call("displayMessage", {
            message = "Reveal each hero's nemesis minion. If that minion shares a title with a character in play, remove that minion from the game and find an reveal an Underling minion instead.",
            messageType = Global.getVar("MESSAGE_TYPE_INSTRUCTION")
        })

        Global.call("moveCardFromEncounterDeckById", {
            cardId = publicSupportCardId,
            searchInDiscard = true,
            zoneIndex = "environment",
            settings = {
                hideWhenFaceDown = false
            }
        })
    end

    if (stageNumber == "2") then
        Global.call("displayMessage", {
            message = "Find and reveal each hero's nemesis minion. Each player whose nemesis minion did not enter play in this way should find an Underling minion and reveal it instead.",
            messageType = Global.getVar("MESSAGE_TYPE_INSTRUCTION")
        })

        if (mode == "expert") then
            Global.call("moveCardFromEncounterDeckById", {
                cardId = organizedCrimeCardId,
                searchInDiscard = true,
                zoneIndex = "sideScheme"
            })
        end
    end
end

function kingpinPlaceAllNemesisDecks()
    local heroManager = getObjectFromGUID(Global.getVar("GUID_HERO_MANAGER"))
    local players = heroManager.call("getPlayersInPlayerOrder")

    for _, player in ipairs(players) do
        local playmat = heroManager.call("getPlaymat", {
            playerColor = player.playerColor,
            test = "blah"
        })
        local nemesisPosition = Vector(playmat.call("getEncounterCardPosition"))

        spawnNemesis({
            playerColor = player.playerColor,
            position = nemesisPosition
        })
    end
end

function fearNoEvilGetEncounterSetPanel()
    local underlings = {{
        key = "bullseye",
        name = "Bullseye"
    }, {
        key = "electro",
        name = "Electro"
    }, {
        key = "hammerhead",
        name = "Hammerhead",
        label = "Hammer-\nhead"
    }, {
        key = "purpleMan",
        name = "Purple Man",
        fileName = "purple-man",
        label = "Purple\nMan"
    }, {
        key = "typhoidMary",
        name = "Typhoid Mary",
        fileName = "typhoid-mary",
        label = "Typhoid\nMary"
    }}

    local guid = self.getGUID()
    local underlingButtons = {}
    local selectedUnderlingButtonId = selectedScenario.underlingButtonId or "random"
    local randomButtonImageUrl =
        "https://steamusercontent-a.akamaihd.net/ugc/12635327849228453947/CB7134374683D9348843072934D55AF278B01109/"

    for _, underling in pairs(underlings) do
        local isSelected = underling.key == selectedUnderlingButtonId
        local underlingLabel = underling.label or underling.Label or underling.name

        table.insert(underlingButtons, {
            tag = "Panel",
            attributes = {
                preferredHeight = "85",
                preferredWidth = "170",
                id = "underlingHighlight-" .. underling.key,
                color = isSelected and "rgba(1,1,0,1)" or "rgba(0,0,0,0)"
            },
            children = {{
                tag = "Button",
                attributes = {
                    id = underling.key,
                    onClick = guid .. "/fearNoEvilUnderlingButtonClicked",
                    preferredHeight = "85",
                    preferredWidth = "170",
                    color = "rgba(0,0,0,0)",
                    colors = "rgba(1,1,1,1)|rgba(1,1,1,1)|rgba(1,1,1,1)|rgba(1,1,1,1)"
                },
                children = {{
                    tag = "Image",
                    attributes = {
                        image = cdnUrl .. "/selectors/scenarios/selector-" .. (underling.fileName or underling.key) ..
                            ".png",
                        height = "81",
                        width = "166",
                        preserveAspect = "false",
                        rectAlignment = "MiddleCenter"
                    }
                }, {
                    tag = "Text",
                    value = underlingLabel,
                    attributes = {
                        alignment = "MiddleCenter",
                        rectAlignment = "MiddleCenter",
                        offsetXY = "35 7",
                        fontSize = "18",
                        color = "rgba(0,0,0,1)",
                        raycastTarget = "false"
                    }
                }}
            }}
        })
    end

    local randomSelected = selectedUnderlingButtonId == "random"
    table.insert(underlingButtons, {
        tag = "Panel",
        attributes = {
            preferredHeight = "85",
            preferredWidth = "85",
            id = "underlingHighlight-random",
            color = randomSelected and "rgba(1,1,0,1)" or "rgba(0,0,0,0)"
        },
        children = {{
            tag = "Button",
            attributes = {
                id = "random",
                onClick = guid .. "/fearNoEvilUnderlingButtonClicked",
                preferredHeight = "85",
                preferredWidth = "85",
                color = "rgba(0,0,0,0)",
                colors = "rgba(1,1,1,1)|rgba(1,1,1,1)|rgba(1,1,1,1)|rgba(1,1,1,1)"
            },
            children = {{
                tag = "Image",
                attributes = {
                    image = randomButtonImageUrl,
                    height = "81",
                    width = "81",
                    preserveAspect = "false",
                    rectAlignment = "MiddleCenter"
                }
            }}
        }}
    })

    local encounterSetControlPanel = {
        tag = "Panel",
        attributes = {
            preferredHeight = "125",
            flexibleHeight = "0",
            width = "955"
        },
        children = {{
            tag = "VerticalLayout",
            attributes = {
                rectAlignment = "UpperLeft",
                childAlignment = "UpperLeft",
                childForceExpandHeight = "false",
                spacing = "10",
                contentSizeFitter = "vertical"
            },
            children = {{
                tag = "Text",
                value = "Select an underling villain.",
                attributes = {
                    rectAlignment = "UpperLeft",
                    alignment = "UpperLeft",
                    color = "rgba(1,1,1,1)"
                }
            }, {
                tag = "HorizontalLayout",
                attributes = {
                    childAlignment = "MiddleCenter",
                    childForceExpandHeight = "false",
                    childForceExpandWidth = "false",
                    preferredHeight = "85",
                    width = "955",
                    spacing = "4",
                    contentSizeFitter = "vertical"
                },
                children = underlingButtons
            }}
        }}
    }

    return encounterSetControlPanel
end

function fearNoEvilPrepareScenario()
    local selectedVillainKey = selectedScenario.underlingKey or "random"
    local selectedVillain = fearNoEvilGetUnderling(selectedVillainKey)
    local villainKey = selectedVillain.key
    local encounterDeck = currentScenario.decks.encounterDeck
    local villainEncounterCards = selectedVillain.encounterCards

    currentScenario.villains[villainKey] = selectedVillain

    for cardId, count in pairs(villainEncounterCards) do
        encounterDeck.cards[cardId] = count
    end

    if (selectedVillainKey == "typhoidMary") then
        local coinFlip = math.random(2)

        if (coinFlip == 2) then
            currentScenario.villains.typhoidMary.stages.stageA.flipCard = true
            currentScenario.villains.typhoidMary.stages.stageB.flipCard = true
        end
    end
end

function fearNoEvilSetupVillainStage(params)
    local villainKey = params.villainKey
    local stage = params.stage
    local stageNumber = string.sub(stage.key, -1)
    local mode = getMode()

    if (villainKey == "bullseye") then
        local adamantiumSpineCardId = "60068"
        local derangedBloodlustCardId = "60073"

        if (stageNumber == "1") then
            local encounterDeck = Global.call("getEncounterDeck")
            local encounterCards = encounterDeck.getObjects()

            for _, card in pairs(encounterCards) do
                local cardData = Global.call("getCardData", {
                    card = card
                })
                local cardId = cardData.code

                if (cardId == adamantiumSpineCardId) then
                    card = encounterDeck.takeObject({
                        guid = card.guid
                    })
                    if (card) then
                        card.destruct()
                    end
                    break
                end
            end
        end
        if (stageNumber == "2") then
            if (mode == "standard") then
                Global.call("spawnCardAndMoveFromEncounterDeckById", {
                    cardId = adamantiumSpineCardId,
                    zoneIndex = "attachment",
                    settings = {
                        hideWhenFaceDown = false
                    }
                })
            else
                Global.call("moveCardFromEncounterDeckById", {
                    cardId = adamantiumSpineCardId,
                    searchInDiscard = true,
                    zoneIndex = "attachment",
                    settings = {
                        hideWhenFaceDown = false
                    }
                })
            end
        end
        if (stageNumber == "3") then
            Global.call("moveCardFromEncounterDeckById", {
                cardId = derangedBloodlustCardId,
                searchInDiscard = true,
                zoneIndex = "sideScheme"
            })
        end
    end

    if (villainKey == "electro") then
        local electricChargeCardId = "60079"

        function setupElectricShock()
            Global.call("moveCardFromEncounterDeckById", {
                cardId = electricChargeCardId,
                searchInDiscard = true,
                zoneIndex = "attachment"
            })
        end

        function addShockCountersToElectricCharge(multiplier)
            local electricChargeCard = Global.call("findCard", {
                cardId = electricChargeCardId
            })
            local electricChargeCounter = Global.call("getCounterFromCard", {
                card = electricChargeCard,
                counterClass = "configured"
            })
            local heroCount = getHeroCount()

            electricChargeCounter.call("adjustValue", {
                adjustment = heroCount * multiplier
            })
        end

        if (stageNumber == "1") then
            setupElectricShock()
        end

        if (stageNumber == "2") then
            if (mode == "expert") then
                setupElectricShock()
            else
                addShockCountersToElectricCharge(2)
            end
        end

        if (stageNumber == "3") then
            addShockCountersToElectricCharge(3)
        end
    end

    if (villainKey == "typhoidMary") then
        local villainCard = Global.call("findCard", {
            cardId = stage.cardId
        })

        local villainIsFaceUp = Global.call("isFaceUp", {
            object = villainCard,
            ignoreToggles = true
        })

        fearNoEvilApplyTyphoidMaryExpertEffects(mode, villainIsFaceUp)
    end
end

